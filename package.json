{
  "name": "flipbook-pdf",
  "version": "0.1.0",
  "description": "Turn any PDF into a book with a realistic page-curl animation. Mouse, touch and keyboard. Works with plain HTML, React/Next.js, Vue/Nuxt and Angular.",
  "license": "MIT",
  "author": "Yasin Özgür Çakmak",
  "homepage": "https://github.com/yasinozgurcakmak/flipbook-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasinozgurcakmak/flipbook-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/yasinozgurcakmak/flipbook-pdf/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/flipbook-pdf.iife.js",
  "jsdelivr": "./dist/flipbook-pdf.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/adapters/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/adapters/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./iife": "./dist/flipbook-pdf.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/flipbook-pdf.iife.js"
  ],
  "keywords": [
    "pdf",
    "flipbook",
    "page-flip",
    "page-curl",
    "book",
    "pdf-viewer",
    "reader",
    "pdfjs",
    "web-component",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "angular",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode iife && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "node scripts/make-sample-pdf.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "jsdom": "^27.0.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
